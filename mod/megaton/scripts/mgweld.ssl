// SPDX-License-Identifier: LicenseRef-Sustainable-Use
/*
 * mgweld.ssl - Deputy Weld, the robot greeter outside Megaton's gate.
 *
 * A pre-War machine with a cowboy vocabulary and a clerk's soul. Its three
 * directives: greet, deter, summon the sheriff (design brief 5.3, 6.1).
 *   - The first time the player comes within six hexes it turns and floats
 *     the welcome, and sets MG_F_WELD_GREETED: that flag is what opens the gate
 *     (mggate.ssl watches it). If Weld is destroyed before it ever greeted
 *     anybody the flag is set all the same, so the town cannot be locked shut.
 *   - A stock line every half minute or so while the player is near.
 *   - Talking: town directions, bomb reports with bureaucratic qualifications,
 *     a self-diagnostic for Science 40 (25 XP, once), and the welcome again,
 *     slower, for a player of very few words.
 *   - Disarmed greetings claim administrative credit for the player's work.
 *
 * Standard townsperson: hurting it turns the town hostile.
 * Engine test: tests/core/arrival.txt, weld.txt.
 */
#include "mgcore.h"
#define NAME                    SCRIPT_MGWELD

#define LVAR_BOMB_ASKED         (0)       // times the player asked about the bomb
#define LVAR_DIAGNOSED          (1)       // 1 once the self-diagnostic was rewarded
#define LVAR_AMNESTY            (2)       // GVAR_MG_AMNESTY at its last look (mg_honour_amnesty)

#define GREET_RANGE             (6)       // hexes
#define CHATTER_RANGE           (8)
#define TIMER_CHATTER           (1)
#define DIAGNOSTIC_XP           (25)

#define bomb_is_dead            (gvar(GVAR_MG_BOMB) == MG_BOMB_DISARMED)

procedure start;
procedure map_enter_p_proc;
procedure critter_p_proc;
procedure combat_p_proc;
procedure timed_event_p_proc;
procedure damage_p_proc;
procedure destroy_p_proc;
procedure pickup_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure talk_p_proc;
procedure hub_options;
procedure Node000;
procedure Node010;
procedure Node011;
procedure Node020;
procedure Node030;
procedure Node040;

/* Not saved: at worst one stock line is skipped after a reload. */
variable chatter_pending := 0;

/* Keep empty: runs for every event without a handler and twice at map load. */
procedure start begin
end

procedure map_enter_p_proc begin
   chatter_pending := 0;
   mg_honour_amnesty(LVAR_AMNESTY);
end

procedure critter_p_proc begin
   mg_townsperson_critter;
   if (mg_is_hostile == false) then begin
      if (tile_distance_objs(self_obj, dude_obj) <= GREET_RANGE) then begin
         if (mg_flag(MG_F_WELD_GREETED) == false) then begin
            mg_set_flag(MG_F_WELD_GREETED);
            anim(self_obj, ANIMATE_ROTATION, rotation_to_tile(self_tile, dude_tile));
            if (bomb_is_dead) then floater(111);
            else floater(110);
         end else if (chatter_pending == 0) then begin
            chatter_pending := 1;
            restart_timer(seconds(random(25, 40)), TIMER_CHATTER);
         end
      end
   end
end

procedure timed_event_p_proc begin
   if (fixed_param == TIMER_CHATTER) then begin
      chatter_pending := 0;
      if (self_is_alive and (mg_is_hostile == false) and (combat_is_initialized == 0)) then begin
         if (tile_distance_objs(self_obj, dude_obj) <= CHATTER_RANGE) then begin
            if (bomb_is_dead and (random(1, 3) == 1)) then floater(115);
            else floater_random(112, 114);
         end
      end
   end
end

/* A hostile town warns before it shoots: while the alarm is young he lets his turn pass (megaton.h). */
procedure combat_p_proc begin
   mg_townsperson_combat;
end

procedure damage_p_proc begin
   mg_townsperson_damage;
end

procedure destroy_p_proc begin
   mg_townsperson_destroy;
   /* nobody is left to tell the gate motor anything: it lets go */
   mg_set_flag(MG_F_WELD_GREETED);
end

procedure pickup_p_proc begin
   mg_townsperson_pickup;
end

procedure look_at_p_proc begin
   script_overrides;
   show(100);
end

procedure description_p_proc begin
   script_overrides;
   show(101);
end

procedure talk_p_proc begin
   if (mg_is_hostile) then begin
      floater_color(120, FLOAT_MSG_RED);
   end else begin
      mg_set_flag(MG_F_WELD_GREETED);
      talk(Node000);
   end
end

/* The welcome. */
procedure Node000 begin
   if (bomb_is_dead) then Reply(201);
   else Reply(200);
   call hub_options;
end

procedure hub_options begin
   NOption(210, Node010, 4);
   NOption(211, Node020, 4);
   if (has_skill(dude_obj, SKILL_SCIENCE) >= 40) then NOption(212, Node030, 4);
   NLowOption(213, Node040);
   EndOption(214, 4);
end

/* What is this place? */
procedure Node010 begin
   Reply(220);
   NOption(211, Node020, 4);
   NOption(221, Node011, 4);
   EndOption(214, 4);
end

/* A Vault, a GECK: not this unit's jurisdiction. */
procedure Node011 begin
   Reply(222);
   NOption(211, Node020, 4);
   EndOption(214, 4);
end

/* What bomb? The same answer, word for word; the third time with small print. */
procedure Node020 begin
   set_lvar(LVAR_BOMB_ASKED, lvar(LVAR_BOMB_ASKED) + 1);
   if (bomb_is_dead) then begin
      Reply(233);
   end else if (lvar(LVAR_BOMB_ASKED) >= 3) then begin
      Reply(232);
   end else begin
      Reply(230);
   end
   if (bomb_is_dead == false) then NOption(231, Node020, 4);
   NOption(210, Node010, 4);
   EndOption(214, 4);
end

/* Science: run a self-diagnostic. */
procedure Node030 begin
   if (lvar(LVAR_DIAGNOSED) == 0) then begin
      set_lvar(LVAR_DIAGNOSED, 1);
      mg_give_xp(DIAGNOSTIC_XP);
   end
   Reply(240);
   NOption(210, Node010, 4);
   EndOption(214, 4);
end

/* The welcome again, slower and louder. */
procedure Node040 begin
   Reply(250);
   NLowOption(251, DIALOG_END);
end
