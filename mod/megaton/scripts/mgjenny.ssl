// SPDX-License-Identifier: LicenseRef-Sustainable-Use
/*
 * mgjenny.ssl - Jenny Stahl, at the open counter of the Brass Lantern
 * (design brief 5.5, 6.11).
 *
 * A minor merchant: food and clean water with real barter (JENNY_STOCK in
 * `restock` is the only list; refilled as mgmerch.h describes), a few level
 * answers about her family and the saloon, and her cold opinion of Jericho.
 * No quest hangs on her.
 *
 * Reads: GVAR_MG_BOMB, GVAR_MG_SIMMS. Writes: GVAR_MG_MERCH_DEAD (her bit), GVAR_MG_RESTOCK_DAY.
 *
 * Engine tests: tests/merchants/jenny.txt, restock.txt, dead.txt.
 */
#include "mgmerch.h"
#define NAME                    SCRIPT_MGJENNY

#define LVAR_MET                (0)       // 1 once the player has talked to her
#define LVAR_STOCKED            (1)       // GVAR_MG_RESTOCK_DAY + 1 at her last restock (0 = never)
#define LVAR_AMNESTY            (2)       // mg_merch_cool_off
#define LVAR_GRUDGE_DAY         (3)       // mg_merch_cool_off

#define COUNTER_CASH            (80)


procedure start;
procedure map_enter_p_proc;
procedure critter_p_proc;
procedure combat_p_proc;
procedure damage_p_proc;
procedure destroy_p_proc;
procedure pickup_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure talk_p_proc;
procedure restock;
procedure hub_options;
procedure exits;
procedure Node001;
procedure NodeHub;
procedure NodeBarter;
procedure NodeFamily;
procedure NodeSaloon;
procedure NodeJericho;
procedure NodeJericho2;
procedure NodeStew;
procedure NodeDumbBarter;

/* Keep empty: runs for every event without a handler and twice at map load. */
procedure start begin
end

procedure map_enter_p_proc begin
   mg_merch_cool_off(LVAR_AMNESTY, LVAR_GRUDGE_DAY);
   if (self_is_alive and (is_loading_game == 0)) then mg_check_stock(LVAR_STOCKED, restock);
end

procedure critter_p_proc begin
   mg_townsperson_critter;
   mg_merch_note_grudge(LVAR_GRUDGE_DAY);
end

/* A hostile town warns before it attacks: while the alarm is young he lets his turn pass (megaton.h). */
procedure combat_p_proc begin
   mg_townsperson_combat;
end

procedure damage_p_proc begin
   mg_townsperson_damage;
end

procedure destroy_p_proc begin
   mg_townsperson_destroy;
   mg_merch_died(MG_DEAD_JENNY);
end

procedure pickup_p_proc begin
   mg_townsperson_pickup;
end

procedure look_at_p_proc begin
   script_overrides;
   show(100);
end

procedure description_p_proc begin
   script_overrides;
   show(101);
end

procedure talk_p_proc begin
   if (mg_is_hostile) then begin
      mg_hostile_bark;
   end else begin
      mg_check_stock(LVAR_STOCKED, restock);
      talk(Node001);
   end
end

/* JENNY_STOCK: what the Brass Lantern serves (design brief 5.5). */
procedure restock begin
   mg_stock(PID_IGUANA_ON_A_STICK_103, 4);
   mg_stock(PID_MEAT_JERKY, 5);
   mg_stock(PID_FRUIT, 4);
   mg_stock(PID_NUKA_COLA, 4);
   mg_stock(PID_WATER_FLASK, 2);
   mg_stock_cash(COUNTER_CASH);
end

procedure Node001 begin
   if (lvar(LVAR_MET) == 0) then begin
      set_lvar(LVAR_MET, 1);
      Reply(200);
   end else if (gvar(GVAR_MG_SIMMS) == MG_SIMMS_DEAD) then begin
      Reply(203);
   end else if (gvar(GVAR_MG_BOMB) == MG_BOMB_DISARMED) then begin
      Reply(202);
   end else begin
      Reply(201);
   end
   call hub_options;
end

procedure NodeHub begin
   Reply(230);
   call hub_options;
end

procedure hub_options begin
   NOption(210, NodeBarter, 4);
   NOption(211, NodeFamily, 4);
   NOption(212, NodeSaloon, 4);
   NOption(213, NodeJericho, 4);
   NOption(217, NodeStew, 4);
   EndOption(214, 4);
   NLowOption(215, NodeDumbBarter);
   NLowOption(216, DIALOG_END);
end

procedure exits begin
   NOption(231, NodeHub, 4);
   EndOption(214, 4);
end

procedure NodeBarter begin
   barter;
   Reply(230);
   call exits;
end

procedure NodeFamily begin
   Reply(220);
   call exits;
end

procedure NodeSaloon begin
   Reply(221);
   call exits;
end

procedure NodeJericho begin
   Reply(222);
   NOption(223, NodeJericho2, 4);
   call exits;
end

procedure NodeJericho2 begin
   Reply(224);
   call exits;
end

procedure NodeStew begin
   Reply(225);
   NOption(210, NodeBarter, 4);
   call exits;
end

procedure NodeDumbBarter begin
   barter;
   Reply(232);
   NLowOption(233, NodeDumbBarter);
   NLowOption(216, DIALOG_END);
end
