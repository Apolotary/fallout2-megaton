// SPDX-License-Identifier: LicenseRef-Sustainable-Use
/*
 * mgdoc.ssl - Doc Church, Megaton Clinic (design brief 5.5, 6.7).
 *
 * Services, paid before treatment into his own purse:
 *   heal        $3 per missing hit point, at least $20, at most $150; also
 *               sets crippled limbs and eyes. One hour passes.
 *   radiation   $150 flat, removes all of it. Two hours pass. A poisoned patient
 *               is sold the antidote first: poison keeps biting while the clock
 *               runs, and two hours of it can kill a weak one in his chair.
 *   poison      $40 flat, done in a moment (not in the brief: his greeting asks
 *               "hurt, sick or glowing?", so "sick" needed an answer). It also
 *               closes two hit points of wound, because the engine lets one
 *               last poison tick (-1 hp) through after any cure, and a patient
 *               on his last hit point must not drop dead on the way out.
 *   colleague   Doctor >= 40: one exchange of shop talk takes a quarter off
 *               every service for good (LVAR_COLLEAGUE) and brings the hint
 *               that Mentats help with the bomb.
 * An INT <= 3 patient gets the same treatment at the same price through "Owie".
 * Barter: a small medical stock, DOC_STOCK in `restock` (the only list;
 * refilled as mgmerch.h describes). His Mentats matter for the bomb (mgbomb).
 *
 * `service` and `price` are script variables: they only live from the quote
 * to the payment inside one conversation, so they need not be saved.
 *
 * Reads: GVAR_MG_BOMB, GVAR_MG_SIMMS. Writes: GVAR_MG_MERCH_DEAD (his bit), GVAR_MG_RESTOCK_DAY.
 *
 * Engine tests: tests/merchants/doc.txt, doc-colleague.txt, doc-dumb.txt, dead.txt.
 */
#include "mgmerch.h"
#define NAME                    SCRIPT_MGDOC

#define LVAR_MET                (0)       // 1 once the player has talked to him
#define LVAR_STOCKED            (1)       // GVAR_MG_RESTOCK_DAY + 1 at his last restock (0 = never)
#define LVAR_COLLEAGUE          (2)       // 1 = quarter off all services
#define LVAR_AMNESTY            (3)       // mg_merch_cool_off
#define LVAR_GRUDGE_DAY         (4)       // mg_merch_cool_off

#define CLINIC_CASH             (300)
#define HEAL_PER_HP             (3)
#define HEAL_MIN                (20)
#define HEAL_MAX                (150)
#define RAD_PRICE               (150)
#define POISON_PRICE            (40)
#define COLLEAGUE_DOCTOR        (40)      // Doctor skill that earns the colleague's rate

#define SERVICE_HEAL            (1)
#define SERVICE_RADIATION       (2)
#define SERVICE_POISON          (3)

#define DAM_CRIP_ANY            (124)     // legs, arms and eyes (DAM_CRIP_* of fo2.h)

#define FLOAT_RANGE             (6)
#define TIMER_FLOAT             (1)


#define missing_hp              (dude_stat(STAT_MAX_HP) - dude_stat(STAT_CURRENT_HP))
#define dude_is_crippled        ((critter_state(dude_obj) bwand DAM_CRIP_ANY) != 0)
#define dude_is_hurt            ((missing_hp > 0) or dude_is_crippled)
#define dude_rads               dude_stat(STAT_CURRENT_RADIATION)
#define dude_poison             get_poison(dude_obj)
#define colleague_rate(n)       (((n) * 3 / 4) if (lvar(LVAR_COLLEAGUE) == 1) else (n))

procedure start;
procedure map_enter_p_proc;
procedure critter_p_proc;
procedure combat_p_proc;
procedure timed_event_p_proc;
procedure damage_p_proc;
procedure destroy_p_proc;
procedure pickup_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure talk_p_proc;
procedure restock;
procedure set_price;
procedure treat;
procedure Node001;
procedure hub_options;
procedure NodeHub;
procedure NodeHeal;
procedure NodeRads;
procedure NodePoison;
procedure NodeQuote;
procedure NodePay;
procedure NodeBarter;
procedure NodeAtom;
procedure NodeBomb;
procedure NodeColleague;
procedure NodeDumb;
procedure NodeDumbPay;

variable float_pending := 0;
variable service := 0;                    // SERVICE_* being quoted
variable price := 0;                      // what it costs this patient

/* Keep empty: runs for every event without a handler and twice at map load. */
procedure start begin
end

procedure map_enter_p_proc begin
   mg_merch_cool_off(LVAR_AMNESTY, LVAR_GRUDGE_DAY);
   if (self_is_alive and (is_loading_game == 0)) then mg_check_stock(LVAR_STOCKED, restock);
end

procedure critter_p_proc begin
   mg_townsperson_critter;
   mg_merch_note_grudge(LVAR_GRUDGE_DAY);
   if ((float_pending == 0) and (distance_to_dude <= FLOAT_RANGE) and (mg_is_hostile == 0)) then begin
      float_pending := 1;
      timer(seconds(random(30, 50)), TIMER_FLOAT);
   end
end

procedure timed_event_p_proc begin
   if (fixed_param == TIMER_FLOAT) then begin
      float_pending := 0;
      if (self_is_alive and (mg_is_hostile == 0) and (distance_to_dude <= FLOAT_RANGE)) then floater_random(110, 113);
   end
end

/* A hostile town warns before it attacks: while the alarm is young he lets his turn pass (megaton.h). */
procedure combat_p_proc begin
   mg_townsperson_combat;
end

procedure damage_p_proc begin
   mg_townsperson_damage;
end

procedure destroy_p_proc begin
   mg_townsperson_destroy;
   mg_merch_died(MG_DEAD_DOC);
end

procedure pickup_p_proc begin
   mg_townsperson_pickup;
end

procedure look_at_p_proc begin
   script_overrides;
   show(100);
end

procedure description_p_proc begin
   script_overrides;
   show(101);
end

procedure talk_p_proc begin
   if (mg_is_hostile) then begin
      mg_hostile_bark;
   end else begin
      mg_check_stock(LVAR_STOCKED, restock);
      talk(Node001);
   end
end

/* DOC_STOCK: what the clinic can spare (design brief 5.5). */
procedure restock begin
   mg_stock(PID_STIMPAK, 6);
   mg_stock(PID_SUPER_STIMPAK, 1);
   mg_stock(PID_FIRST_AID_KIT, 1);
   mg_stock(PID_DOCTORS_BAG, 1);
   mg_stock(PID_RADAWAY, 3);
   mg_stock(PID_RAD_X, 2);
   mg_stock(PID_ANTIDOTE, 3);
   mg_stock(PID_MENTATS, 2);              // +10 on the bomb (mgbomb)
   mg_stock(PID_BUFFOUT, 1);
   mg_stock_cash(CLINIC_CASH);
end

/* price := what `service` costs right now. */
procedure set_price begin
   if (service == SERVICE_HEAL) then begin
      price := missing_hp * HEAL_PER_HP;
      if (price < HEAL_MIN) then price := HEAL_MIN;
      if (price > HEAL_MAX) then price := HEAL_MAX;
   end else if (service == SERVICE_RADIATION) then begin
      price := RAD_PRICE;
   end else begin
      price := POISON_PRICE;
   end
   price := colleague_rate(price);
end

/* The treatment itself; the caller has taken the money. */
procedure treat begin
   if (service == SERVICE_HEAL) then begin
      critter_heal(dude_obj, missing_hp);
      critter_injure(dude_obj, DAM_CRIP_ANY bwor DAM_PERFORM_REVERSE);
      game_time_advance(hours(1));
   end else if (service == SERVICE_RADIATION) then begin
      radiation_dec(dude_obj, dude_rads);
      game_time_advance(hours(2));
   end else begin
      poison(dude_obj, 0 - dude_poison);
      critter_heal(dude_obj, 2);        // see the header: the last tick must not kill
   end
end

/* D0 */
procedure Node001 begin
   if (lvar(LVAR_MET) == 0) then begin
      set_lvar(LVAR_MET, 1);
      Reply(200);
   end else if (gvar(GVAR_MG_SIMMS) == MG_SIMMS_DEAD) then begin
      Reply(204);
   end else if (gvar(GVAR_MG_BOMB) == MG_BOMB_DISARMED) then begin
      Reply(203);
   end else if (lvar(LVAR_COLLEAGUE) == 1) then begin
      Reply(202);
   end else begin
      Reply(201);
   end
   call hub_options;
end

procedure NodeHub begin
   Reply(272);
   call hub_options;
end

procedure hub_options begin
   if (dude_is_hurt) then NOption(210, NodeHeal, 4);
   if (dude_rads > 0) then NOption(211, NodeRads, 4);
   if (dude_poison > 0) then NOption(212, NodePoison, 4);
   NOption(213, NodeBarter, 4);
   NOption(214, NodeAtom, 4);
   if ((lvar(LVAR_COLLEAGUE) == 0) and (has_skill(dude_obj, SKILL_DOCTOR) >= COLLEAGUE_DOCTOR)) then GOption(215, NodeColleague, 4);
   EndOption(216, 4);
   NLowOption(217, NodeDumb);
   NLowOption(218, DIALOG_END);
end

procedure NodeHeal begin
   service := SERVICE_HEAL;
   call NodeQuote;
end

/* The flush takes two hours; whatever bit the patient has to go first. */
procedure NodeRads begin
   if (dude_poison > 0) then begin
      service := SERVICE_POISON;
      call set_price;
      ReplyText(mstr(238) + price + mstr(239));
      NOption(222, NodePay, 4);
      NOption(223, NodeHub, 4);
   end else begin
      service := SERVICE_RADIATION;
      call NodeQuote;
   end
end

procedure NodePoison begin
   service := SERVICE_POISON;
   call NodeQuote;
end

/* He names the price; nothing happens until the player pays. */
procedure NodeQuote begin
   call set_price;
   if (service == SERVICE_HEAL) then
      ReplyText(mstr(220) + price + mstr(221));
   else if (service == SERVICE_RADIATION) then
      ReplyText(mstr(230) + price + mstr(231));
   else
      ReplyText(mstr(235) + price + mstr(236));
   NOption(222, NodePay, 4);
   NOption(223, NodeHub, 4);
end

procedure NodePay begin
   call set_price;
   if (mg_dude_has_caps(price)) then begin
      mg_pay(self_obj, price);
      call treat;
      if (service == SERVICE_HEAL) then
         Reply(224);
      else if (service == SERVICE_RADIATION) then
         Reply(232);
      else
         Reply(237);
   end else begin
      Reply(225);
   end
   NOption(271, NodeHub, 4);
   EndOption(216, 4);
end

procedure NodeBarter begin
   barter;
   Reply(270);
   NOption(271, NodeHub, 4);
   EndOption(216, 4);
end

/* D2: the Children of Atom, seen from the clinic. */
procedure NodeAtom begin
   Reply(240);
   NOption(241, NodeBomb, 4);
   NOption(271, NodeHub, 4);
   EndOption(216, 4);
end

procedure NodeBomb begin
   if (gvar(GVAR_MG_BOMB) == MG_BOMB_DISARMED) then
      Reply(243);
   else if (gvar(GVAR_MG_BOMB) == MG_BOMB_RIGGED) then
      Reply(244);
   else
      Reply(242);
   NOption(271, NodeHub, 4);
   EndOption(216, 4);
end

/* Doctor >= 40: shop talk. A quarter off from now on, and the Mentats hint. */
procedure NodeColleague begin
   set_lvar(LVAR_COLLEAGUE, 1);
   Reply(250);
   NOption(251, NodeHub, 4);
   EndOption(216, 4);
end

/* INT <= 3: "Owie." He treats whatever is worst first, at the normal price, and says which it is.
   The radiation flush only from DUMB_RADS up: everybody who has walked past the bomb carries a few
   rads, and every unhurt visitor of few words was quoted $150 for a service nobody had named. */
#define DUMB_RADS               (25)
#define service_line            (1 if (service == SERVICE_HEAL) else (2 if (service == SERVICE_POISON) else 3))
procedure NodeDumb begin
   if (dude_is_hurt) then
      service := SERVICE_HEAL;
   else if (dude_poison > 0) then
      service := SERVICE_POISON;
   else if (dude_rads >= DUMB_RADS) then
      service := SERVICE_RADIATION;
   else
      service := 0;
   if (service == 0) then begin
      Reply(265);
      NLowOption(218, DIALOG_END);
   end else begin
      call set_price;
      /* he says what the money is for: 267 hurt, 268 poisoned, 269 glowing */
      ReplyText(mstr(266 + service_line) + mstr(260) + price + mstr(261));
      NLowOption(262, NodeDumbPay);
      NLowOption(263, DIALOG_END);
   end
end

procedure NodeDumbPay begin
   call set_price;
   if (mg_dude_has_caps(price)) then begin
      mg_pay(self_obj, price);
      call treat;
      Reply(264);
   end else begin
      Reply(266);
   end
   NLowOption(217, NodeDumb);
   NLowOption(218, DIALOG_END);
end
